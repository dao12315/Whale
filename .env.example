# Environment variables template

# AI Studio
GEMINI_API_KEY=

# Server & App Config
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/whale_db?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="your-super-secret-access-key-minimum-32-characters"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-32-characters"
JWT_REFRESH_EXPIRATION="7d"

# Google OAuth 2.0 & Google Drive API
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_SERVICE_ACCOUNT_EMAIL="whale-drive-service@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

# Payment Gateways (VNPay)
VNPAY_TMN_CODE="VNPAY_MERCHANT_CODE"
VNPAY_HASH_SECRET="VNPAY_SECRET_KEY"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/payment-result"

# Payment Gateways (MoMo)
MOMO_PARTNER_CODE="MOMO_PARTNER_CODE"
MOMO_ACCESS_KEY="MOMO_ACCESS_KEY"
MOMO_SECRET_KEY="MOMO_SECRET_KEY"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# Storage & CDN (Cloudflare R2 / AWS S3 for public thumbnails)
PUBLIC_STORAGE_BUCKET="whale-public-assets"
PUBLIC_STORAGE_REGION="auto"
PUBLIC_STORAGE_ACCESS_KEY_ID="storage-access-key"
PUBLIC_STORAGE_SECRET_ACCESS_KEY="storage-secret-key"
PUBLIC_STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
PUBLIC_CDN_BASE_URL="https://cdn.shanhai.studio"
