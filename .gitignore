# =========================================================================
# DANH MỤC CÁC MỤC BỊ CHẶN KHÔNG ĐẨY LÊN GIT (.gitignore)
# =========================================================================

# 1. Thư mục tài liệu văn phòng & bản nháp nội bộ
tailieu_word/
docs/
*.docx
*.doc
*.pdf
*.xlsx

# 2. Thư viện phụ thuộc & Mã nguồn biên dịch
node_modules/
dist/
dist-ssr/
build/
out/
coverage/
.vite/

# 3. Biến môi trường & Khóa bí mật (Secrets & Credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert

# 4. Nhật ký hoạt động & Bộ nhớ đệm (Logs & Cache)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# 5. Công cụ AI Studio, Agent & Tệp tạm thời
.aistudio/
.agents/
.gemini/
.tempmediaStorage/
tmp/
temp/
*.tmp

# 6. Tệp hệ điều hành & Trình soạn thảo (OS & IDE)
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
