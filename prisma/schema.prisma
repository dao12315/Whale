// prisma/schema.prisma
// Database Schema for Whale (GGC Studio / Yizhen Shanhai) Platform
// Relational Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// 1. ENUMS (Hệ thống Định Danh & Phân Loại)
// =========================================================================

enum MembershipTier {
  FREE      // Thành viên tiêu chuẩn
  GOLD      // Thành viên Gold (Chiết khấu 10%)
  SUPREME   // Thành viên Supreme VIP (Chiết khấu 30%)
  ADMIN     // Quản trị viên hệ thống
}

enum UserRole {
  USER        // Học viên / Người dùng thông thường
  INSTRUCTOR  // Giảng viên / Nghệ sĩ đóng góp khóa học
  ADMIN       // Quản trị viên toàn quyền
}

enum ContentStatus {
  DRAFT       // Bản nháp đang biên soạn
  PUBLISHED   // Đã công khai trên hệ thống
  ARCHIVED    // Đã lưu trữ / Tạm ẩn
}

enum OrderStatus {
  PENDING     // Đang chờ thanh toán
  COMPLETED   // Đã thanh toán thành công
  FAILED      // Thanh toán thất bại
  CANCELLED   // Đơn hàng bị hủy
  REFUNDED    // Đã hoàn tiền và thu hồi quyền
}

enum PaymentMethod {
  CREDITS         // Thanh toán trừ ví Credits nội bộ
  VNPAY           // Cổng thanh toán VNPay (QR / Thẻ ATM / Visa)
  MOMO            // Ví điện tử MoMo
  BANK_TRANSFER   // Chuyển khoản ngân hàng trực tiếp
  FREE            // Mở khóa miễn phí 0đ
}

enum PaymentStatus {
  PENDING   // Đang chờ cổng thanh toán phản hồi
  SUCCESS   // Thanh toán thành công (Đã xác minh chữ ký Webhook)
  FAILED    // Thất bại / Hết hạn thanh toán
}

enum OrderItemType {
  COURSE            // Mua khóa học trọn gói
  RESOURCE          // Mua tài nguyên vẽ tranh lẻ (Brush, LUTs, Texture, PSD...)
  VIP_UPGRADE       // Nâng cấp gói thành viên VIP
  CREDIT_TOPUP      // Gói nạp Credits vào ví
}

enum EnrollmentStatus {
  ACTIVE    // Đang có quyền truy cập hợp lệ
  REVOKED   // Bị thu hồi quyền (Hoàn tiền / Vi phạm điều khoản)
  EXPIRED   // Hết hạn quyền truy cập (nếu có thời hạn)
}

enum DriveGrantStatus {
  GRANTED   // Cấp quyền Reader thành công trên Google Drive API
  REVOKED   // Thu hồi quyền thành công trên Google Drive API
  FAILED    // Gặp lỗi khi gọi Google Drive API (cần hàng đợi retry)
}

enum ReadingPermission {
  PUBLIC    // Mọi người đều đọc được
  GOLD      // Chỉ hội viên Gold trở lên
  SUPREME   // Chỉ hội viên Supreme VIP
  PASSWORD  // Khóa bằng mật khẩu bài viết
}

enum ForumCategory {
  SUMMARY     // Tổng hợp
  ATTENTION   // Quan tâm / Theo dõi
  SECTION     // Chuyên mục
  POPULAR     // Phổ biến / Xu hướng
  ESSENCE     // Bài viết tinh hoa / Chọn lọc
  QA          // Hỏi đáp thắc mắc
  VOTING      // Bình chọn / Thăm dò ý kiến
}

enum NotificationType {
  COMMENT     // Có người bình luận / phản hồi
  GROUP_BUY   // Cập nhật tiến độ đợt mua chung
  SYSTEM      // Thông báo hệ thống
  VIP         // Thăng hạng hội viên
  CREDIT      // Biến động số dư ví Credits
  ORDER       // Trạng thái đơn hàng / thanh toán
}

// =========================================================================
// 2. USERS, AUTHENTICATION & SECURITY
// =========================================================================

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(255)
  googleEmail     String?        @map("google_email") @db.VarChar(255) // Email nhận quyền Google Drive
  googleId        String?        @unique @map("google_id") @db.VarChar(100) // Google OAuth Sub ID
  passwordHash    String?        @map("password_hash") @db.VarChar(255) // Argon2id hoặc Bcrypt hash
  name            String         @db.VarChar(100)
  avatarUrl       String?        @map("avatar_url") @db.VarChar(500)
  tier            MembershipTier @default(FREE)
  role            UserRole       @default(USER)
  credits         Int            @default(0) // Số dư ví xu Credits
  points          Int            @default(0) // Điểm tích lũy hoạt động
  balanceVnd      BigInt         @default(0) @map("balance_vnd") // Số dư ví tiền mặt (VND)
  bio             String?        @db.Text
  heat            Int            @default(0) // Điểm nhiệt độ hoạt động tương tác
  isBanned        Boolean        @default(false) @map("is_banned")
  banReason       String?        @map("ban_reason") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  // Quan hệ
  refreshTokens     RefreshToken[]
  enrollments       Enrollment[]
  orders            Order[]
  driveGrants       DriveAccessGrant[]
  checkinLogs       CheckinLog[]
  courseComments    CourseComment[]
  courseReplies     CommentReply[]
  courseLikes       CourseLike[]
  wishlists         Wishlist[]
  forumPosts        ForumPost[]
  forumComments     ForumComment[]
  pollVotes         PollVote[]
  notifications     Notification[]
  chatMessages      ChatMessage[]
  auditLogs         AuditLog[]
  followers         UserFollow[] @relation("UserFollowers")
  following         UserFollow[] @relation("UserFollowing")

  @@index([email])
  @@index([googleEmail])
  @@index([role])
  @@index([tier])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255) // Lưu hash SHA-256 của token
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByToken   String?   @map("replaced_by_token") @db.VarChar(255) // Cơ chế Token Rotation
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

model CheckinLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  checkinDate     String   @map("checkin_date") @db.VarChar(10) // Format: "YYYY-MM-DD"
  pointsRewarded  Int      @default(15) @map("points_rewarded")
  creditsRewarded Int      @default(5) @map("credits_rewarded")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkinDate]) // Đảm bảo mỗi ngày chỉ điểm danh 1 lần
  @@index([userId])
  @@map("checkin_logs")
}

// =========================================================================
// 3. CATALOG: KHÓA HỌC, BÀI HỌC, TÀI NGUYÊN & DANH MỤC
// =========================================================================

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(50) // coloso, blender, color, character, unreal...
  name        String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses   Course[]
  resources Resource[]

  @@map("categories")
}

model Tag {
  id        String      @id @default(uuid()) @db.Uuid
  slug      String      @unique @db.VarChar(50)
  name      String      @db.VarChar(50)
  createdAt DateTime    @default(now()) @map("created_at")

  courses CourseTag[]

  @@map("tags")
}

model CourseTag {
  courseId String @map("course_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
  @@map("course_tags")
}

model Course {
  id                String        @id @default(uuid()) @db.Uuid
  code              String        @unique @db.VarChar(50) // Mã số nhận diện trên UI, ví dụ: "[480]", "[FREE-01]"
  title             String        @db.VarChar(255)
  titleZh           String?       @map("title_zh") @db.VarChar(255) // Tên gốc Hán tự kèm ngày tháng lễ hội
  subtitle          String?       @db.Text
  description       String?       @db.Text
  categoryId        String        @map("category_id") @db.Uuid
  instructorName    String        @map("instructor_name") @db.VarChar(100)
  instructorRole    String?       @map("instructor_role") @db.VarChar(150)
  authorAvatarUrl   String?       @map("author_avatar_url") @db.VarChar(500)
  thumbnailUrl      String        @map("thumbnail_url") @db.VarChar(500)
  bannerUrl         String?       @map("banner_url") @db.VarChar(500)
  eventDate         String?       @map("event_date") @db.VarChar(100) // Ví dụ: "2026.05.09 农历四月廿三日"
  isFree            Boolean       @default(false) @map("is_free")
  originalUrl       String?       @map("original_url") @db.VarChar(1000)
  
  // Giá tiền tệ chuẩn hóa (VND là BigInt, Credits là Int)
  priceVnd          BigInt        @default(0) @map("price_vnd") // Giá bán bằng tiền mặt VND
  originalCredits   Int           @default(50) @map("original_credits") // Giá gốc tính bằng Credits
  goldCredits       Int           @default(45) @map("gold_credits") // Giá cho hạng Gold
  supremeCredits    Int           @default(35) @map("supreme_credits") // Giá kịch sàn cho Supreme VIP
  
  // Marketing FOMO Group Buy counters
  groupBuyTarget    Int           @default(20) @map("group_buy_target")
  groupBuyCurrent   Int           @default(14) @map("group_buy_current")
  groupBuyDeadline  DateTime?     @map("group_buy_deadline")
  
  // Thống kê tương tác
  viewsCount        Int           @default(0) @map("views_count")
  likesCount        Int           @default(0) @map("likes_count")
  commentsCount     Int           @default(0) @map("comments_count")
  status            ContentStatus @default(PUBLISHED)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  category        Category           @relation(fields: [categoryId], references: [id])
  sections        CourseSection[]
  lessons         Lesson[]
  resources       Resource[]
  mediaList       CourseMedia[]
  tags            CourseTag[]
  enrollments     Enrollment[]
  orderItems      OrderItem[]
  comments        CourseComment[]
  likes           CourseLike[]
  wishlists       Wishlist[]
  driveGrants     DriveAccessGrant[]

  @@index([code])
  @@index([categoryId])
  @@index([status])
  @@index([isFree])
  @@index([createdAt])
  @@map("courses")
}

model CourseSection {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id            String    @id @default(uuid()) @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  sectionId     String?   @map("section_id") @db.Uuid
  title         String    @db.VarChar(255)
  duration      String    @default("00:00") @db.VarChar(20) // Hiển thị thời lượng "25:00"
  sortOrder     Int       @default(0) @map("sort_order")
  isFreePreview Boolean   @default(false) @map("is_free_preview") // Bài học thử miễn phí
  
  // BẢO MẬT: CHỈ LƯU ID GOOGLE DRIVE, KHÔNG LƯU LINK CÔNG KHAI
  driveFileId   String?   @map("drive_file_id") @db.VarChar(150)
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section     CourseSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  driveGrants DriveAccessGrant[]

  @@index([courseId])
  @@index([sectionId])
  @@map("lessons")
}

model Resource {
  id             String    @id @default(uuid()) @db.Uuid
  courseId       String?   @map("course_id") @db.Uuid // Nullable: Tài nguyên có thể bán lẻ độc lập
  categoryId     String?   @map("category_id") @db.Uuid
  title          String    @db.VarChar(255) // VD: "Bộ 50+ LUTs Rec.709 & Project DaVinci"
  description    String?   @db.Text
  fileType       String    @map("file_type") @db.VarChar(50) // PSD, ABR, CUBE, ZIP, BLEND...
  fileSizeBytes  BigInt    @default(0) @map("file_size_bytes")
  
  // BẢO MẬT: ID Tệp / Thư Mục Drive được phân quyền
  driveFileId    String    @map("drive_file_id") @db.VarChar(150)
  
  isFree         Boolean   @default(false) @map("is_free")
  priceVnd       BigInt    @default(0) @map("price_vnd")
  priceCredits   Int       @default(0) @map("price_credits")
  downloadsCount Int       @default(0) @map("downloads_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  orderItems  OrderItem[]
  driveGrants DriveAccessGrant[]

  @@index([courseId])
  @@index([categoryId])
  @@index([fileType])
  @@map("resources")
}

model CourseMedia {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  mediaType String   @default("IMAGE") @map("media_type") @db.VarChar(20) // IMAGE | PREVIEW_VIDEO
  url       String   @db.VarChar(500)
  caption   String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_media")
}

// =========================================================================
// 4. ORDERS, PAYMENTS & ENROLLMENTS (ENTITLEMENT CORE)
// =========================================================================

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  orderCode          String        @unique @map("order_code") @db.VarChar(50) // VD: "GGC-842911"
  userId             String        @map("user_id") @db.Uuid
  totalAmountVnd     BigInt        @default(0) @map("total_amount_vnd")
  discountAmountVnd  BigInt        @default(0) @map("discount_amount_vnd")
  finalAmountVnd     BigInt        @default(0) @map("final_amount_vnd")
  totalCredits       Int           @default(0) @map("total_credits")
  paymentMethod      PaymentMethod @default(CREDITS) @map("payment_method")
  status             OrderStatus   @default(PENDING)
  idempotencyKey     String?       @unique @map("idempotency_key") @db.VarChar(100) // Chống xử lý trùng webhook
  notes              String?       @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id])
  orderItems  OrderItem[]
  payments    Payment[]
  enrollments Enrollment[]

  @@index([userId])
  @@index([orderCode])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  itemType     OrderItemType @map("item_type")
  courseId     String?       @map("course_id") @db.Uuid
  resourceId   String?       @map("resource_id") @db.Uuid
  priceVnd     BigInt        @default(0) @map("price_vnd")
  priceCredits Int           @default(0) @map("price_credits")
  createdAt    DateTime      @default(now()) @map("created_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([courseId])
  @@index([resourceId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  paymentGateway PaymentMethod @map("payment_gateway")
  transactionId  String?       @map("transaction_id") @db.VarChar(150) // Mã giao dịch trả về từ VNPay/MoMo
  amountVnd      BigInt        @map("amount_vnd")
  status         PaymentStatus @default(PENDING)
  signature      String?       @db.VarChar(500) // Chữ ký HMAC SHA512 từ cổng thanh toán
  webhookPayload Json?         @map("webhook_payload") // Lưu toàn bộ payload IPN phục vụ đối soát
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  courseId   String?          @map("course_id") @db.Uuid
  resourceId String?          @map("resource_id") @db.Uuid
  orderId    String?          @map("order_id") @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  expiresAt  DateTime?        @map("expires_at") // Null = Quyền sở hữu trọn đời
  revokedAt  DateTime?        @map("revoked_at")
  reason     String?          @db.Text

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, courseId])
  @@index([userId, resourceId])
  @@map("enrollments")
}

model DriveAccessGrant {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  courseId     String?          @map("course_id") @db.Uuid
  lessonId     String?          @map("lesson_id") @db.Uuid
  resourceId   String?          @map("resource_id") @db.Uuid
  googleEmail  String           @map("google_email") @db.VarChar(255)
  driveFileId  String           @map("drive_file_id") @db.VarChar(150)
  permissionId String?          @map("permission_id") @db.VarChar(150) // ID do Drive API trả về
  role         String           @default("reader") @db.VarChar(50)
  status       DriveGrantStatus @default(GRANTED)
  errorMessage String?          @map("error_message") @db.Text
  grantedAt    DateTime         @default(now()) @map("granted_at")
  revokedAt    DateTime?        @map("revoked_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([googleEmail])
  @@index([driveFileId])
  @@index([permissionId])
  @@map("drive_access_grants")
}

// =========================================================================
// 5. SOCIAL, COMMENTS, LIKES & WISHLISTS
// =========================================================================

model CourseComment {
  id         String   @id @default(uuid()) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  content    String   @db.Text
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies CommentReply[]

  @@index([courseId, createdAt])
  @@map("course_comments")
}

model CommentReply {
  id              String   @id @default(uuid()) @db.Uuid
  parentCommentId String   @map("parent_comment_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  content         String   @db.Text
  likesCount      Int      @default(0) @map("likes_count")
  createdAt       DateTime @default(now()) @map("created_at")

  parentComment CourseComment @relation(fields: [parentCommentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parentCommentId])
  @@map("comment_replies")
}

model CourseLike {
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("course_likes")
}

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("wishlists")
}

// =========================================================================
// 6. FORUM & COMMUNITY
// =========================================================================

model ForumBoard {
  id            String   @id @db.VarChar(50) // board-inspiration, board-asset, board-need-tutorial...
  title         String   @db.VarChar(100)
  description   String   @db.Text
  iconType      String   @map("icon_type") @db.VarChar(50)
  postsCount    Int      @default(0) @map("posts_count")
  heatCount     Int      @default(0) @map("heat_count")
  likesCount    Int      @default(0) @map("likes_count")
  isLocked      Boolean  @default(false) @map("is_locked")
  hasFlameBadge Boolean  @default(false) @map("has_flame_badge")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  posts ForumPost[]

  @@map("forum_boards")
}

model ForumPost {
  id                String            @id @default(uuid()) @db.Uuid
  boardId           String            @map("board_id") @db.VarChar(50)
  authorId          String            @map("author_id") @db.Uuid
  title             String            @db.VarChar(255)
  content           String            @db.Text
  coverImageUrl     String?           @map("cover_image_url") @db.VarChar(500)
  images            Json? // Mảng các ảnh đính kèm: string[]
  tags              Json? // Mảng thẻ: string[]
  category          ForumCategory     @default(SUMMARY)
  readingPermission ReadingPermission @default(PUBLIC) @map("reading_permission")
  passwordHash      String?           @map("password_hash") @db.VarChar(255)
  readsCount        Int               @default(0) @map("reads_count")
  likesCount        Int               @default(0) @map("likes_count")
  commentsCount     Int               @default(0) @map("comments_count")
  isVotingEnabled   Boolean           @default(false) @map("is_voting_enabled")
  status            ContentStatus     @default(PUBLISHED)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  board       ForumBoard     @relation(fields: [boardId], references: [id])
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    ForumComment[]
  pollOptions PollOption[]
  pollVotes   PollVote[]

  @@index([boardId])
  @@index([authorId])
  @@index([category])
  @@index([createdAt])
  @@map("forum_posts")
}

model PollOption {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  optionText String   @map("option_text") @db.VarChar(255)
  votesCount Int      @default(0) @map("votes_count")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  post  ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([postId])
  @@map("poll_options")
}

model PollVote {
  id           String   @id @default(uuid()) @db.Uuid
  pollOptionId String   @map("poll_option_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId]) // Mỗi user chỉ vote 1 lần cho 1 cuộc thăm dò
  @@index([postId])
  @@map("poll_votes")
}

model ForumComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.Text
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  likesCount Int     @default(0) @map("likes_count")
  createdAt DateTime @default(now()) @map("created_at")

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("forum_comments")
}

// =========================================================================
// 7. NOTIFICATIONS, CHAT & AUDIT LOGS
// =========================================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  linkUrl   String?          @map("link_url") @db.VarChar(500)
  courseId  String?          @map("course_id") @db.VarChar(100)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  message        String   @db.Text
  isAnnouncement Boolean  @default(false) @map("is_announcement")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid // Người thực hiện hành động (Nullable nếu là system job)
  action     String   @db.VarChar(100) // VD: 'GRANT_DRIVE_PERMISSION', 'REVOKE_ENROLLMENT', 'COURSE_UPDATE'
  targetType String   @map("target_type") @db.VarChar(50) // 'COURSE', 'USER', 'ENROLLMENT', 'ORDER'
  targetId   String?  @map("target_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
